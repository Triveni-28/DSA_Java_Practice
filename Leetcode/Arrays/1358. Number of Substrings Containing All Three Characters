class Solution {
    public int numberOfSubstrings(String s) {
        int n = s.length();
        int lastA = -1, lastB = -1, lastC = -1; // last seen indices
        int ans = 0;

        for (int i = 0; i < n; i++) {
            char ch = s.charAt(i);

            if (ch == 'a') lastA = i;
            else if (ch == 'b') lastB = i;
            else lastC = i;

            // Find earliest index where we can start valid substring
            int minLast = Math.min(lastA, Math.min(lastB, lastC));

            if (minLast != -1) {
                ans += minLast + 1; // all substrings from 0…minLast ending at i
            }
        }

        return ans;
    }
}
