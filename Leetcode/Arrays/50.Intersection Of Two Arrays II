class Solution {
    public int[] intersect(int[] nums1, int[] nums2) {
        Arrays.sort(nums1);
        Arrays.sort(nums2);
        int[] res=new int[Math.min(nums1.length,nums2.length)];
        int i=0,j=0,k=0;
        while(i<nums1.length&&j<nums2.length){
            if(nums1[i]==nums2[j]){
                res[k++]=nums1[i];
                i++;
                j++;
            }else if(nums1[i]<nums2[j]){
                i++;
            }else{
                j++;
            }
        }
        int[] res1=new int[k];
        for(int t=0;t<k;t++){
            res1[t]=res[t];
        }
        return res1;
    }
}
