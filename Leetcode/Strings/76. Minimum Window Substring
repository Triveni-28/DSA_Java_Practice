import java.util.*;

class Solution {
    public String minWindow(String s, String t) {
        HashMap<Character, Integer> hs = new HashMap<>();
        int l = 0, r = 0, cnt = 0, minlen = Integer.MAX_VALUE, start = -1;

        for (int i = 0; i < t.length(); i++) {
            char c = t.charAt(i);
            hs.put(c, hs.getOrDefault(c, 0) + 1);
        }

        while (r < s.length()) {
            char rc = s.charAt(r);
            if (hs.containsKey(rc) && hs.get(rc) > 0) cnt = cnt + 1;
            if (hs.containsKey(rc)) hs.put(rc, hs.get(rc) - 1);
            r = r + 1;

            while (cnt == t.length()) {
                if (r - l < minlen) {
                    minlen = r - l;
                    start = l;
                }
                char lc = s.charAt(l);
                if (hs.containsKey(lc)) hs.put(lc, hs.get(lc) + 1);
                if (hs.containsKey(lc) && hs.get(lc) > 0) cnt = cnt - 1;
                l = l + 1;
            }
        }

        return start == -1 ? "" : s.substring(start, start + minlen);
    }
}
