class Solution {
    public int longestSubarray(int[] nums, int k) {
        int n = nums.length;
        int left = 0, sum = 0, maxLen = 0;
        
        for (int right = 0; right < n; right++) {
            sum += nums[right];   // expand window
            
            // shrink window until sum <= k
            while (sum > k) {
                sum -= nums[left];
                left++;
            }
            
            // update max length
            maxLen = Math.max(maxLen, right - left + 1);
        }
        
        return maxLen;
    }
}
